EXPO_PUBLIC_ENVIRONMENT=Development
EXPO_PUBLIC_SENSWAVE__API__URL=http://10.0.2.2:8080

EXPO_PUBLIC_API_GOOGLE_CLIENT_ID=ANY_NON_EMPTY_VALUE

EXPO_PUBLIC_MINIMAL_API_VERSION=1.0.0
EXPO_PUBLIC_CONTACT_EMAIL=contact@senswave.net

# Transport: Rest (default) | Grpc | GrpcWeb. Must match the backend Transport__Mode.
# Grpc and GrpcWeb require an https:// API URL.
EXPO_PUBLIC_TRANSPORT=Rest

# Comma-separated hosts that trust certs/dev-ca.crt (see certs/README.md). Empty disables.
EXPO_PUBLIC_DEV_CA_HOSTS=
